# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/invoizmo
# Production: mongodb+srv://<user>:<pass>@cluster.mongodb.net/invoizmo

# ── JWT Secrets ──────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_hex_access_secret_min_32_characters
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Client & CORS ────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Email (Nodemailer SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_smtp_api_key
EMAIL_FROM=noreply@invoizmo.com
SUPPORT_EMAIL=support@invoizmo.com

# ── PDF Generation ───────────────────────────────────────────────────────
PDF_MAX_CONCURRENCY=2

# ── Monitoring (Optional) ────────────────────────────────────────────────
SENTRY_DSN=
